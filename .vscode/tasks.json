{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Keep lesson PDFs up to date",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build_student_pdfs.py",
        "--watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
